# Researcher discovery — copy to .env and fill in values.
# Never commit .env (it is gitignored).

# Required for live researcher search (GET /api/researchers/search)
# Get a key at https://openalex.org/
OPENALEX_API_KEY=

# Optional enrichment sources (app works without these; not used yet)
SEMANTIC_SCHOLAR_API_KEY=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Toggle optional enrichment from Semantic Scholar / ORCID
RESEARCHER_SEARCH_ENRICHMENT_ENABLED=true

# arXiv Atom API (no API key required)
ARXIV_ENABLED=true
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_USER_AGENT=ResearchIntelligencePlatform/0.1 contact@example.com

# The project currently uses SQLite for local development.
# Relative paths are resolved from the backend/ directory.
DATABASE_URL=sqlite+aiosqlite:///./author_identity.db
AUTHOR_RESOLUTION_ENABLED=true
AUTHOR_AUTO_MERGE_THRESHOLD=85
AUTHOR_POSSIBLE_DUPLICATE_THRESHOLD=60

# Works/grants persistence (canonical works, search sessions, L2 provider cache)
WORK_PERSISTENCE_ENABLED=true
PROVIDER_SEARCH_CACHE_ENABLED=true
PROVIDER_SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_SESSION_TTL_SECONDS=86400
